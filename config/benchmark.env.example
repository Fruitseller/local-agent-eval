# Kopieren nach config/benchmark.env und anpassen.
# Vorhandene Umgebungsvariablen gewinnen immer über diese Datei.

# --- Agent-Endpoint (OpenAI-kompatibel) ------------------------------------
# Beispiel LM Studio / llama.cpp auf localhost:
#PI_BASE_URL=http://localhost:1234/v1
#PI_PROVIDER=local
#PI_MODEL=deepreinforce-ai/Ornith-1.0-35B
#PI_API_KEY=local

# Fallback: komplette eigene pi-Kommandozeile statt generierter Invocation.
# Platzhalter: {prompt_file} {workspace} {model} {provider} {base_url}
#PI_COMMAND=pi -p --mode json --model ${PI_MODEL} @{prompt_file}

# --- Fairness / Isolation ---------------------------------------------------
#BENCH_ISOLATE_PI_CONFIG=true
#BENCH_BUDGET_SECONDS=1200
#BENCH_TEST_TIMEOUT=300
#BENCH_RESTORE_PROTECTED=true

# --- Modell-Capability-Hints (fuer generiertes models.json) ----------------
#PI_CONTEXT_WINDOW=131072
#PI_MAX_TOKENS=8192
#PI_REASONING=false

# --- Output ----------------------------------------------------------------
#BENCH_RESULTS_DIR=./results
#BENCH_LABEL=mein-modell
